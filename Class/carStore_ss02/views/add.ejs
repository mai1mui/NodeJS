<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>add_car</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body class="bg-light">
  <div class="container py-4">
    <a href="">Comeback home</a>
    <h2 class="mb-3">Add New Car</h2>
    <form action="" method="POST">
      <!-- Name -->
      <div class="col-md-6">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" name="name" placeholder="Enter name car" autofocus>
      </div>

      <!-- Price -->
      <div class="col-md-6">
        <label for="price" class="form-label">Price (USD)</label>
        <input type="number" class="form-control" id="price" name="price" placeholder="Enter price car" min="0"> 
      </div>

       <!-- Description-->
      <div class="col-md-6">
        <label for="des" class="form-label">Description</label>
        <input type="text" class="form-control" id="des" name="des" placeholder="Enter description of car">
      </div>

      <div class="col-12 mt-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="reset" class="btn btn-secondary">Cancel</button>
      </div>
    </form>
  </div>


</body>
</html>
