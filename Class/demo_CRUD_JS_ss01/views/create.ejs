<!-- demo create new phone từ chatgpt -->
 <!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Add New Phone</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container py-4">
    <a href="/">Comeback</a>
    <h2 class="mb-3">Add New Phone</h2>
    <form action="/create" method="POST">
      <!-- Name -->
      <div class="col-md-6">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" name="name" placeholder="Please enter product name" required>
      </div>

      <!-- Brand -->
      <div class="col-md-6">
        <label for="brand" class="form-label">Brand</label>
        <input type="text" class="form-control" id="brand" name="brand" placeholder="Please enter a brand" required>
      </div>

      <!-- Price -->
      <div class="col-md-6">
        <label for="price" class="form-label">Price (USD)</label>
        <input type="number" class="form-control" id="price" name="price" placeholder="Please enter a valid price (>= 0)"required>
      </div>

      <div class="col-12 mt-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="reset" class="btn btn-secondary">Cancel</button>
      </div>
    </form>
  </div>
</body>
</html>
