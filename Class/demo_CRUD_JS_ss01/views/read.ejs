<!-- demo list view từ chatgpt -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phone List</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>
    <div class="container mt-4">
        <h2 class="mb-3 text-center">📱 LIST OF PHONES</h2>
        <a class="btn btn-primary" href="/create">Add new phone</a>
        <table class="table table-bordered table-hover">
            <thead class="table-dark text-center">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Brand</th>
                    <th>Price ($)</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <%phones.forEach(item=>{%>
                    <tr class="text-center">
                        <td><%=item.id%></td>
                        <td><%=item.name%></td>
                        <td><%=item.brand%></td>
                        <td><%=item.price%></td>
                        <td>
                            <a class="btn btn-warning btn-sm" href="/update/<%=item.id%>">Update</a>
                            <a class="btn btn-danger btn-sm" href="/delete/<%=item.id%>">Delete</a>
                        </td>
                    </tr>
                    <%})%>

            </tbody>
        </table>
    </div>
</body>

</html>