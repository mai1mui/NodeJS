<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <title>read_list</title>
</head>

<body>
<div class="container mt-3">
    <h2 style="font-size: 3em;">List View</h2>
    <a class="btn btn-primary" href="/create">Add new user</a>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>NAME</th>
                <th>EMAIL</th>
                <th>AGE</th>
                <th>ACTION</th>
            </tr>
        </thead>
        <tbody>
            <%users.forEach(item=>{%>
            <tr>
                <td><%=item.id%></td>
                <td><%=item.name%></td>
                <td><%=item.email%></td>
                <td><%=item.age%></td>
                <td>
                    <a class="btn btn-warning" href="/update/<%=item.id%>">Update</a>
                    <a class="btn btn-danger" href="/delete/<%=item.id%>">Delete</a>
                </td>
            </tr>
            <%})%>
        </tbody>
    </table>
</div>
</body>

</html>