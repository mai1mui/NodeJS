<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background: linear-gradient(135deg, #e3f2fd, #bbdefb);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        .form-box {
            background-color: #fff;
            border-radius: 16px;
            padding: 40px;
            max-width: 500px;
            margin: 0 auto;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        h2 {
            color: #0a4091;
            font-weight: 700;
            letter-spacing: 1px;
        }

        label {
            font-weight: 500;
            color: #1565c0;
        }

        input:focus {
            border-color: #0d47a1 !important;
            box-shadow: 0 0 5px rgba(13, 71, 161, 0.3);
        }

        .btn-primary {
            border: none;
        }

        .btn-primary:hover {
            background-color: #1565c0;
        }

        .btn-warning {
            color: white;
        }

        table {
            width: 100%;
        }
    </style>
    <title>add-view</title>
</head>

<body>
    <div class="container mt-5">
        <a href="/">Quay Lai</a>
        <h2 class="text-center mb-4">ADD NEW CAR</h2>
        <form action="/add" method="POST">
            <table class="text-center mb-4">
                <tr class="mb-3">
                    <td><label class="form-label">Name:</label></td>
                    <td><input type="text" class="form-control" id="name" name="name" placeholder="Enter name car"
                            required></td>
                </tr>

                <tr>
                    <td><label class="form-label">Brand:</label></td>
                    <td><input type="text" class="form-control" id="brand" name="brand" placeholder="Enter brand car"
                            required></td>
                </tr>

                <tr>
                    <td><label class="form-label">Year:</label></td>
                    <td><input type="number" class="form-control" id="year" name="year" placeholder="Enter year of car" required></td>
                </tr>

                <tr>
                    <td><label class="form-label">Price:</label></td>
                    <td><input type="number" class="form-control" id="price" name="price" placeholder="Enter price car"
                            required></td>
                </tr>
            </table>
            <div class="d-flex justify-content-center gap-3">
                <button type="submit" class="btn btn-primary px-4">Save</button>
                <button type="reset" class="btn btn-warning px-4">Cancel</button>
            </div>
        </form>
    </div>
</body>

</html>