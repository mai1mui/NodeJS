<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
    background-color: #f0f4f8;
    font-family: "Segoe UI", sans-serif;
}

h2 {
    color: #0d47a1;
    font-weight: 600;
}

.table {
    background-color: #fff;
    border-radius: 10px;
    overflow: hidden;
}

.table th {
    background-color: #0d47a1 !important;
    color: white;
}

    </style>
    <title>list-view</title>
</head>

<body>
    <div class="container mt-3">
        <h2>LIST CARS</h2>
        <a href="/add" class="btn btn-primary">Add new car</a>
        <form>
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Brand</th>
                        <th>Year</th>
                        <th>Price</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <%cars.forEach(item=>{%>
                        <tr>
                            <td><%=item.id%></td>
                            <td><%=item.name%></td>
                            <td><%=item.brand%></td>
                            <td><%=item.year%></td>
                            <td><%=item.price%></td>
                            <td>
                                <a class="btn btn-warning" href="/edit/<%=item.id%>">Edit</a>
                                <a class="btn btn-danger" href="/delete/<%=item.id%>">Delete</a>
                            </td>
                        </tr>
                        <%})%>
                </tbody>
            </table>
        </form>
    </div>
</body>

</html>