<!DOCTYPE html>
<html lang="en">

<head>
  <title>Bootstrap Example</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>

  <div class="container mt-3">
    <%if(message){%>
    <div class="alert alert-success">
      <strong>Message</strong><%=message%>
    </div>
    <%}%>
  <h2>Product List</h2>
  <a href="/products/add" class="btn btn-primary">Create a new Product</a>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Image</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(item => {%>
    <tr>
      <td><%=item.name%></td>
      <td><%=item.price%></td>
      <td><img src="<%=item.image%>" alt="<%=item.name%>" class="img-thumnail" width="100"></td>
      <td><a class="btn btn-danger" href="/products/delete/<%= item._id%>">Delete</a></td>
    </tr>
    <%})%>

    </tbody>
    </table>
  </div>

</body>

</html>