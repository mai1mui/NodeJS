<!DOCTYPE html>
<html lang="en">

<head>
  <title>Bootstrap Example</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body>

  <div class="container mt-3">
    <h2>List User</h2>
    <a href="/add" class="btn btn-primary">Add a new user</a>
    <table class="table">
      <thead>
        <tr>
          <th>Id</th>
          <th>Name</th>
          <th>Email</th>
          <th>Age</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(item => {%>
        <tr>
          <td><%= item.id%></td>
          <td><%= item.name%></td>
          <td><%= item.email%></td>
          <td><%= item.age%></td>
          <td><a class="btn btn-danger" href="/delete/<%= item.id%>">Delete</a>
            <a class="btn btn-warning" href="/edit/<%= item.id%>">Edit</a>
          </td>
        </tr>
        <%})%>
      </tbody>
    </table>
  </div>

</body>

</html>